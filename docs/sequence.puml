@startuml
title Diagramme de Séquence - Processus de Validation d'une Commande

actor Client as "Utilisateur / Client"
participant "cmd : Commande" as Commande
participant "strat : LivraisonStrategy" as Strategy
participant "config : ConfigurationProvider" as Config
participant "notif : NotificationService" as Notif

Client -> Commande : valider(notif, config)
activate Commande

' 1. Vérification de l'état
alt etat != BROUILLON (déjà validée)
    Commande --> Client : throw IllegalStateException("Commande déjà validée")
else etat == BROUILLON

    ' 2. Vérification du contenu
    alt lignes est vide
        Commande --> Client : throw ValidationCommandeException("La commande ne contient aucun article")
    else panier non vide

        ' 3. Vérification du poids maximal
        Commande -> Commande : calculerPoidsTotalGrammes()
        Commande -> Config : getPoidsMaximalGrammes()
        activate Config
        Config --> Commande : 30000
        deactivate Config

        alt poidsTotal > 30000 g (Branche de Refus Métier)
            note over Commande : L'état reste BROUILLON.
Aucune notification émise.
            Commande --> Client : throw ValidationCommandeException("Poids maximal (30 000 g) dépassé")
        else poidsTotal <= 30000 g (Cas Nominal Succès)

            ' 4. Calcul délégué des frais et du total
            Commande -> Commande : calculerSousTotalCentimes()
            Commande -> Strategy : calculerFrais(sousTotal, poidsTotal, config)
            activate Strategy
            Strategy -> Config : getSeuilGratuiteStandardCentimes() (si Standard)
            activate Config
            Config --> Strategy : 10000
            deactivate Config
            Strategy --> Commande : fraisCentimes
            deactivate Strategy

            ' 5. Figeage du total et transition d'état
            Commande -> Commande : figerTotal(sousTotal + fraisCentimes)
            Commande -> Commande : transitionVers(EtatCommande.VALIDEE)

            ' 6. Déclenchement de la notification via l'abstraction
            Commande -> Notif : notifierValidation(client, totalValide)
            activate Notif
            Notif --> Commande : ack
            deactivate Notif

            Commande --> Client : validation confirmée (succès)
        end
    end
end

deactivate Commande
@enduml
